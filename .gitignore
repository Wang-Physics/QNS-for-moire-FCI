!result/data/nu1of3_2band_ground_state.npz
!result/data/nu1of3_3band_ground_state.npz
!result/data/nu1of3_4band_ground_state.npz
!result/data/nu1of3_5band_ground_state.npz

# LaTeX intermediates, local audits, backups, and inspection-only previews.
result/**/*.aux
result/**/*.log
result/**/*.out
result/**/*.orig
result/result/
result/compile_final.log
result/final_test_audit.log
result/figures/*_preview.png
texput.log
*.orig

# Downloaded papers are cited by DOI/arXiv in references/README.md.
references/*.pdf
