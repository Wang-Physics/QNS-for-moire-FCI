!result/data/*.json
!result/data/fig2_bloch_mesh.npz
!result/data/fig2_1band_ground_state.npz
!result/data/fig2_2band_ground_state.npz
!result/data/fig2_3band_ground_state.npz
!result/data/fig2_4band_ground_state.npz
!result/data/fig2_5band_ground_state.npz
